<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the opening screen is the app icon on the night sky, held until the page is drawn -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:colorBackground">@color/night</item>
        <item name="android:statusBarColor">@color/night</item>
        <item name="android:navigationBarColor">@color/night</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:windowSplashScreenBackground">@color/night</item>
    </style>
</resources>
