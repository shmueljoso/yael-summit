{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yael-summit",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // The message board's storage. Created automatically on the first deploy.
  "kv_namespaces": [
    { "binding": "BOARD" }
  ],
  // GEMINI_API_KEY is a secret: add it in the dashboard (Settings → Variables and Secrets).
  "vars": {
    "GEMINI_MODEL": "gemini-3.5-flash-lite"
  },
  "observability": { "enabled": true }
}
